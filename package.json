{
  "name": "pi-hush",
  "version": "0.3.0",
  "description": "Hide Pi's tool chatter behind a compact activity animation.",
  "author": "Lucas Barcelos",
  "contributors": [
    "Jesse Zhang"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludoroo/pi-hush.git"
  },
  "homepage": "https://github.com/ludoroo/pi-hush#readme",
  "bugs": {
    "url": "https://github.com/ludoroo/pi-hush/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "hush",
    "focus",
    "working-indicator",
    "animation",
    "tui"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "docs/*.md",
    "docs/advanced",
    "docs/assets",
    "docs/preview.html",
    "README.md",
    "LICENSE",
    "package.json",
    "animation-api.ts"
  ],
  "type": "module",
  "exports": {
    "./animation-api": "./animation-api.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/ludoroo/pi-hush/main/docs/assets/animations.gif",
    "extensions": [
      "./extensions/hush/index.ts"
    ]
  },
  "dependencies": {
    "smol-toml": "1.9.0",
    "toml-eslint-parser": "0.10.0"
  }
